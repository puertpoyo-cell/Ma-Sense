    "coach.noWeight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No weight logged for over a week. How about weighing in on an easy morning?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중 기록이 일주일 넘게 비어 있어요. 편한 아침에 한 번 재 볼까요."
          }
        }
      }
    },
    "coach.noWeight.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No weight logged for a while. One reading when convenient keeps the trend going."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중 기록이 한동안 비어 있어요. 편할 때 한 번만 재 봐도 흐름이 이어져요."
          }
        }
      }
    },
    "coach.noWeight.v3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recent weight. It's about the trend, so now and then is fine."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요즘 체중 기록이 없네요. 흐름을 보려는 거라 가끔이어도 괜찮아요."
          }
        }
      }
    },
    "coach.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General wellness information. For your situation, consult your doctor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 건강관리 정보예요. 개인 상황은 의사와 상의하세요."
          }
        }
      }
    },
    "coach.place.clinic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jot down what you heard right after a visit. It makes the next visit easier to pick up."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진료 직후에 들은 것을 바로 적어 두면 다음 진료 때 이어 가기 쉬워요."
          }
        }
      }
    },
    "coach.place.clinic.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a lab sheet photo and I'll fill in the numbers. Check them against the sheet once."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사지는 사진으로 넣어 두면 숫자를 읽어 채워 드려요. 검사지와 한 번 맞춰 봐요."
          }
        }
      }
    },
    "coach.place.clinic.v3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Questions before a visit, notes right after. Keep them together here."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물어볼 것은 진료 전에, 들은 것은 진료 직후에. 여기 한곳에 모아 둬요."
          }
        }
      }
    },
    "coach.place.history": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past records are handy to look at with your doctor. Gaps are okay."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 기록은 진료 때 의사와 함께 보기 좋아요. 빈 날이 있어도 괜찮아요."
          }
        }
      }
    },
    "coach.place.history.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skim your records. They make good talking points at the clinic."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쌓인 기록을 한번 훑어봐요. 진료 때 이야깃거리가 돼요."
          }
        }
      }
    },
    "coach.place.history.v3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty days show in gray. You can tap past days to fill them in."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 날은 회색으로 보여요. 지나간 날도 눌러서 채울 수 있어요."
          }
        }
      }
    },
    "coach.place.pens": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick look at your remaining pens before a visit makes the prescription talk easier."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 펜 수를 진료 전에 한 번 보아 두면 처방 이야기가 한결 편해요."
          }
        }
      }
    },
    "coach.place.pens.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pen picture shows what's left at a glance. Take a look before your visit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펜 그림에서 남은 양을 한눈에 볼 수 있어요. 진료 전에 한 번 살펴봐요."
          }
        }
      }
    },
    "coach.place.pens.v3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Knowing how fast pens run down makes preparing for the next visit easier."

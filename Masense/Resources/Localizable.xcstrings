    "protein.guide": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The general guide is 1.2–1.6 g per kg of body weight. For kidney disease or other individual conditions, consult your doctor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반적인 권고 범위는 체중 1 kg당 1.2~1.6 g입니다. 신장 질환 등 개인 상황은 의사와 상의하세요."
          }
        }
      }
    },
    "report.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This report organizes what you recorded yourself and contains no medical judgment or recommendation. Prescription and treatment decisions rest with your doctor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 리포트는 사용자가 직접 기록한 내용을 정리한 것이며 의학적 판단이나 권고를 포함하지 않습니다. 처방과 치료 결정은 담당 의사에게 있습니다."
          }
        }
      }
    },
    "report.empty": {

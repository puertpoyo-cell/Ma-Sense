    "info.proteinFoods.estimate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are average estimates and vary by product. Use the nutrition label when there is one. Nutrient values for individual foods are listed in the Korean Ministry of Food and Drug Safety nutrient database."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 식품 평균 추정치이며 제품마다 다릅니다. 포장의 영양성분표가 있으면 그 값을 따르세요. 식품별 성분은 식품의약품안전처 식품영양성분 데이터베이스에서 찾아볼 수 있습니다."
          }
        }
      }
    },

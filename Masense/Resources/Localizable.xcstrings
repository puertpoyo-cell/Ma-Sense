    "foodPhoto.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are not saved; only the food type is checked on this device. Amounts and protein grams are approximate; nutrition labels come first."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 저장하지 않고 기기 안에서 음식 종류만 봅니다. 양과 단백질 g은 대략이며 영양성분표가 우선입니다."
          }
        }
      }
    },

    "coach.tip.0.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No need to be perfect. One line when you remember will do."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완벽하게 적지 않아도 돼요. 생각날 때 한 줄이면 돼요."
          }
        }
      }
    },
    "coach.tip.0.v3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missed days are okay. Just pick up again with one line today."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠진 날이 있어도 괜찮아요. 오늘 한 줄부터 다시 이어 가면 돼요."
          }
        }
      }
    },
    "coach.tip.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weighing at the same time and in the same way makes the trend easier to read."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중은 같은 시간, 같은 조건에서 재면 흐름을 보기 쉬워요."
          }
        }
      }
    },
    "coach.tip.1.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weighing at the same moment, like after the bathroom in the morning, makes comparison easier."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중은 아침에 일어나 화장실 다녀온 뒤처럼 늘 같은 때 재면 비교가 쉬워요."
          }
        }
      }
    },
    "coach.tip.1.v3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same spot, same time for the scale. That keeps the trend clear."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중계는 같은 자리, 같은 시간에. 그래야 흐름이 잘 보여요."
          }
        }
      }
    },
    "coach.tip.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try spreading protein across your meals rather than all at once."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단백질은 한 번에 몰기보다 끼니마다 조금씩 나눠 챙겨 보세요."
          }
        }
      }
    },
    "coach.tip.2.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spreading protein across breakfast, lunch and dinner makes it easier."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단백질은 아침·점심·저녁에 조금씩 나누면 챙기기 쉬워요."
          }
        }
      }
    },
    "coach.tip.2.v3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try adding one protein food to each meal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끼니마다 단백질 식품 하나씩 곁들여 보세요."
          }
        }
      }
    },
    "coach.tip.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How about starting the day with a glass of water?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물 한 잔으로 하루를 시작해 볼까요."
          }
        }
      }
    },
    "coach.tip.3.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shall we start with a glass of water within reach?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물 한 컵을 가까이 두고 시작해 볼까요."
          }
        }
      }
    },
    "coach.tip.3.v3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sip of water before you feel thirsty. Let's keep it up today."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목이 마르기 전에 물 한 모금, 오늘도 같이 챙겨요."
          }
        }
      }
    },
    "coach.tip.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a question comes up, jot it down in Questions for the visit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "궁금한 점이 떠오르면 '물어볼 것'에 바로 적어 두세요."
          }
        }
      }
    },
    "coach.tip.4.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If a question for your doctor comes up, jot it in 'Questions' before it slips away."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진료 때 물어보고 싶은 게 떠오르면 잊기 전에 '물어볼 것'에 적어 두세요."
          }
        }
      }
    },
    "coach.tip.4.v3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note questions right away. They're easy to forget in the clinic."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "궁금한 건 바로 메모해요. 진료실에선 생각보다 잘 안 떠오르거든요."
          }
        }
      }
    },
    "coach.tip.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strength work can start small, like standing up from a chair."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근력운동은 의자에서 앉았다 일어나기처럼 작은 동작부터 시작할 수 있어요."
          }
        }
      }
    },
    "coach.tip.5.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strength work can start with easy moves like wall push-ups."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근력운동은 벽 짚고 팔굽혀펴기처럼 쉬운 동작부터 해도 돼요."
          }
        }
      }
    },
    "coach.tip.5.v3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short bits of movement add up. Start with small moves."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 움직임도 쌓이면 기록이 돼요. 작은 동작부터 해 봐요."
          }
        }
      }
    },
    "coach.tip.6": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping a regular bedtime and wake time makes the day's rhythm easier to keep."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠드는 시간과 깨는 시간이 일정하면 하루 리듬을 잡기 쉬워요."
          }
        }
      }
    },
    "coach.tip.6.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shall we head to bed at the usual time tonight?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 평소 시간에 잠자리에 들어 볼까요."
          }
        }
      }
    },
    "coach.tip.6.v3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rest is part of the routine too. Try keeping bedtime steady."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘 쉬는 것도 루틴이에요. 잠드는 시간을 비슷하게 맞춰 보세요."
          }
        }
      }
    },
    "coach.tip.7": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some days the numbers go up and down. Taking care of one thing today is enough."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자가 오르내리는 날도 있어요. 오늘 할 일 하나만 챙겨도 돼요."
          }
        }
      }
    },
    "coach.tip.7.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Numbers can go up and down day to day. Just take care of one thing today."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자는 하루하루 오르내릴 수 있어요. 오늘 할 일 하나만 챙겨요."
          }
        }
      }
    },
    "coach.tip.7.v3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the numbers aside and start small, like a glass of water or one line."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자는 잠시 내려놓고, 물 한 잔이나 기록 한 줄 같은 작은 일부터 해요."
          }
        }
      }
    },

    "info.general": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General wellness information, not personal advice. For your situation, consult your doctor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 건강관리 정보이며 개인 맞춤 안내가 아닙니다. 개인 상황은 의사와 상의하세요."
          }
        }
      }
    },
    "info.hairShedding.addQuestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add to questions"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물어볼 것에 적기"
          }
        }
      }
    },
    "info.hairShedding.body1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hair can shed more than usual about 2 to 3 months after rapid weight loss or another big change in the body (telogen effluvium)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중이 빠르게 줄거나 몸에 큰 변화가 있은 뒤 2~3개월쯤 지나, 머리카락이 평소보다 많이 빠지는 일이 있다고 알려져 있습니다(휴지기 탈모)."
          }
        }
      }
    },
    "info.hairShedding.body2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is known to usually improve over several months, but it differs by person and may have other causes. The app does not judge the cause."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대개 몇 달에 걸쳐 나아지는 것으로 알려져 있지만, 사람마다 다르고 다른 원인이 있을 수도 있습니다. 앱은 원인을 판단하지 않습니다."
          }
        }
      }
    },
    "info.hairShedding.body3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may also relate to nutrition, so showing your meal and protein records at a visit can help the conversation."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영양 상태와도 관련될 수 있다고 알려져 있어, 진료 때 식사·단백질 기록을 함께 보여 주면 이야기가 수월합니다."
          }
        }
      }
    },
    "info.hairShedding.consult": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you shed more hair than usual or are worried, talk with your doctor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머리카락이 평소보다 많이 빠지거나 걱정되면 의사와 상의하세요."
          }
        }
      }
    },
    "info.hairShedding.draft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recently shedding more hair than usual"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 머리카락이 평소보다 많이 빠짐"
          }
        }
      }
    },
    "info.hairShedding.record": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record it as 'Hair shedding' in a condition check and it appears in symptom flow and the report."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨디션 체크에서 '머리카락 빠짐'으로 기록해 두면 증상 흐름과 리포트에 함께 나옵니다."
          }
        }
      }
    },
    "info.hairShedding.source": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source: American Academy of Dermatology, \"Hair shedding\""
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출처: 미국피부과학회(AAD) 탈모 안내 'Hair shedding'"
          }
        }
      }
    },
    "info.hairShedding.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

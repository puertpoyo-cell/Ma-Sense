    "exercise.general": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The examples below are general health information, not a personalized exercise prescription. Adjust them to how you feel."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 예시는 일반 건강관리 정보이며 개인 맞춤 운동 처방이 아닙니다. 몸 상태에 맞게 조절하세요."
          }
        }
      }
    },
    "exercise.routine.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit down on a chair and stand up, 10 times"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의자에 앉았다 일어나기 10회"
          }
        }
      }
    },
    "exercise.routine.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wall push-ups, 10 times"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽 짚고 팔굽혀펴기 10회"
          }
        }
      }
    },
    "exercise.routine.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lying hip raises, 10 times"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누워서 엉덩이 들기 10회"
          }
        }
      }
    },
    "exercise.routine.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On hands and knees, reach out arm and opposite leg, 8 each side"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네발 자세에서 팔과 반대쪽 다리 뻗기 좌우 8회"
          }
        }
      }
    },
    "exercise.routine.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heel raises, 15 times"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "까치발 들기 15회"
          }
        }
      }
    },
    "exercise.routine.repeat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2–3 rounds, 30 seconds of rest between moves"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2~3바퀴, 동작 사이 30초 쉬기"
          }
        }
      }
    },
    "exercise.routine.title": {
      "extractionState": "manual",

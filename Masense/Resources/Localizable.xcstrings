    "age.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is a record-keeping tool for adults aged 19 or older who have a doctor's prescription."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 의사의 처방을 받은 만 19세 이상 성인을 위한 기록 도구입니다."
          }
        }
      }
    },
    "app.name": {
      "extractionState": "manual",

    "coach.answer.condition.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A condition check opens 24 and 48 hours after a dose. A short note is enough."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투약 후 24시간, 48시간에 컨디션 칸이 열려요. 짧게 남겨 두면 돼요."
          }
        }
      }
    },
    "coach.answer.condition.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'Symptom flow' in the Report tab shows how each cycle went."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리포트 탭의 '증상 흐름 보기'에서 마디별로 어떻게 지나갔는지 볼 수 있어요."
          }
        }
      }
    },
    "coach.answer.condition.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't judge worrying symptoms alone. Talk with your doctor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신경 쓰이는 증상은 혼자 판단하지 말고 의사와 상의하세요."
          }
        }
      }
    },
    "coach.answer.sleep.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Putting screens down a bit earlier may help you fall asleep."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자기 전에 화면을 조금 일찍 내려놓으면 잠드는 데 도움이 될 수 있어요."
          }
        }
      }
    },
    "coach.answer.sleep.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark 'Sleep' in the habit check to see it alongside your condition notes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "습관 체크의 '수면'에 표시해 두면 컨디션 기록과 함께 볼 수 있어요."
          }
        }
      }
    },
    "coach.answer.water.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small sips often tend to be easier than a lot at once."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물은 한 번에 많이보다 자주 조금씩 마시는 편이 수월해요."
          }
        }
      }
    },
    "coach.answer.water.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap 'Water' in Today's habit check to follow your day."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 마디 습관 체크에서 '수분'을 눌러 두면 하루 흐름을 보기 쉬워요."
          }
        }
      }
    },
    "coach.answer.weight.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Weight trend you can switch periods. Tap a point to see that day's number."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중 추이에서 기간을 바꿔 가며 흐름을 볼 수 있어요. 점을 누르면 그날 숫자가 나와요."
          }
        }
      }
    },

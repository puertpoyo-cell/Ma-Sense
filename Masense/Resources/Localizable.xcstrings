    "coach.greeting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, you called? What would you like to know."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네, 불렀어요? 무엇이 궁금해요."
          }
        }
      }
    },
    "coach.greeting.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What shall we talk about today? Pick one below."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 어떤 이야기를 해 볼까요. 아래에서 골라 주세요."
          }
        }
      }
    },
    "coach.greeting.v3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good to see you. Tap a topic you're curious about."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반가워요. 궁금한 주제를 눌러 주세요."
          }
        }
      }
    },
    "coach.lowAppetite": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your appetite is lower today. Pick whatever feels easiest from the small, frequent foods in Today's rhythm."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입맛이 줄어든 날이에요. 오늘의 마디에 모아 둔 '작게 자주' 식품에서 편한 것부터 골라 보세요."
          }
        }
      }
    },
    "coach.lowAppetite.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A low-appetite day. Small and often may feel easier than a lot at once."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입맛이 없는 날이에요. 한 번에 많이보다 작게 자주가 편할 수 있어요."
          }
        }
      }
    },
    "coach.lowAppetite.v3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On low-appetite days, start with one easy item from the 'small and often' list."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식욕이 줄어든 날엔 '작게 자주' 목록에서 부담 없는 것 하나부터 골라 보세요."
          }
        }
      }
    },
    "coach.lowCondition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's a heavy day. Resting or a short walk counts as a record too."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몸이 무거운 날이에요. 쉬기나 가벼운 걷기도 그대로 기록이 돼요."
          }
        }
      }
    },
    "coach.lowCondition.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A heavy day for your body. Resting counts as a record too."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 몸이 무거운 날이네요. 쉬는 것도 그대로 기록하면 돼요."
          }
        }
      }
    },
    "coach.lowCondition.v3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take it slow on heavy days. A light walk or rest is still a record."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨디션이 무거우면 천천히 가도 괜찮아요. 가벼운 걷기나 쉬기도 기록이 돼요."
          }
        }
      }
    },

    "bodymap.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each area shows the date it was last used. The last site is solid; the three before it are faint."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구역의 날짜는 그 부위를 마지막으로 쓴 날입니다. 직전 1회는 진하게, 그 전 3회는 옅게 표시됩니다."
          }
        }
      }
    },

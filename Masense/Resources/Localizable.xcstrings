    "onboarding.role.noAdvice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Masense gives no medical advice. Prescription and treatment decisions rest with your doctor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의학적 조언을 하지 않습니다. 처방과 치료 결정은 담당 의사에게 있습니다."
          }
        }
      }
    },
    "onboarding.role.noJudgment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Masense does not evaluate or judge your records."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마선생은 기록을 평가하거나 판단하지 않습니다."

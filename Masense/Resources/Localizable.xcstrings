    "action.cancel" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "취소" } }
      }
    },
    "action.logDose" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Log dose" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "투약 기록" } }
      }
    },
    "age.notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This app is a record-keeping tool for adults aged 19 or older who have a doctor's prescription." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 앱은 의사의 처방을 받은 만 19세 이상 성인을 위한 기록 도구입니다." } }
      }
    },
    "data.local" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "All records are stored only on this device and are never sent anywhere." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "모든 기록은 이 기기에만 저장되며 외부로 전송되지 않습니다." } }
      }
    },
    "exercise.general" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The examples below are general health information, not a personalized exercise prescription. Adjust them to how you feel." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "아래 예시는 일반 건강관리 정보이며 개인 맞춤 운동 처방이 아닙니다. 몸 상태에 맞게 조절하세요." } }
      }
    },
    "history.empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No records yet." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "아직 기록이 없습니다." } }
      }
    },
    "notif.clinic.soon" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your appointment is tomorrow. Have the report ready." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "내일 진료입니다. 리포트를 준비해 두세요." } }
      }
    },
    "notif.condition.h24" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "One day after dosing. Please record how you feel." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "투약 후 하루, 컨디션을 기록해 주세요." } }
      }
    },
    "notif.condition.h48" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Two days after dosing. Please record how you feel." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "투약 후 이틀, 컨디션을 기록해 주세요." } }
      }
    },
    "notif.dose.due" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Today is a dosing day." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "오늘은 투약일입니다." } }
      }
    },
    "notif.dose.evening" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "There is no record yet today." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "아직 기록이 없습니다." } }
      }
    },
    "notif.prescription.low" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld doses remain. Check your next appointment." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "남은 회차가 %lld회입니다. 진료 예약을 확인하세요." } }
      }
    },
    "pace.notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your recent weight change is faster than the general guide (0.5–1% per week). Consider discussing it at your next appointment." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "최근 체중 변화가 일반 권고 범위(주 0.5~1%)보다 빠릅니다. 진료 때 상의해 보세요." } }
      }
    },
    "protein.guide" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The general guide is 1.2–1.6 g per kg of body weight. For kidney disease or other individual conditions, consult your doctor." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "일반적인 권고 범위는 체중 1 kg당 1.2~1.6 g입니다. 신장 질환 등 개인 상황은 의사와 상의하세요." } }
      }
    },
    "report.disclaimer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This report organizes what you recorded yourself and contains no medical judgment or recommendation. Prescription and treatment decisions rest with your doctor." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 리포트는 사용자가 직접 기록한 내용을 정리한 것이며 의학적 판단이나 권고를 포함하지 않습니다. 처방과 치료 결정은 담당 의사에게 있습니다." } }
      }
    },
    "report.empty" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A report becomes available once there are records." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "기록이 쌓이면 리포트를 만들 수 있습니다." } }
      }
    },
    "role.notice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The doctor prescribes; Masense records. Masense only records and organizes your doses and daily life. It gives no medical advice or judgment." } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "처방은 의사가, 기록은 마선생이. 마선생은 투약과 생활을 기록하고 정리할 뿐, 의학적 조언이나 판단을 하지 않습니다." } }
      }
    },

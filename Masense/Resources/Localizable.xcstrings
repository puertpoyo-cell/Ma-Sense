    "coach.tip.0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short notes are fine. Line by line, they make your visit easier to talk through."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 짧아도 괜찮아요. 한 줄씩 쌓이면 진료 때 이야기하기 쉬워져요."

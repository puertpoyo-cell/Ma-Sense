    "pace.notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over the last 2 weeks your weight went down faster than the general guide (0.5–1 kg per week). This is only a general guide and differs by person, so talk with your doctor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 2주 체중이 일반 권장 속도(주 0.5~1 kg)보다 빠르게 줄었습니다. 일반적인 권장일 뿐 사람마다 다를 수 있으니 의사와 상의하세요."
          }
        }
      }
    },

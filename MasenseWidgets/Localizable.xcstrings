{
  "sourceLanguage": "en",
  "strings": {
    "widget.caption.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logged this cycle · Next dose"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 마디 기록 완료 · 다음 투약"
          }
        }
      }
    },
    "widget.caption.exhausted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a new prescription"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 처방을 입력하세요"
          }
        }
      }
    },
    "widget.caption.next": {
      "extractionState": "manual",
      "localizations": {

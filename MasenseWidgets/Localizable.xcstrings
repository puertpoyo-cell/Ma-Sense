          "stringUnit": {
            "state": "translated",
            "value": "Next dose"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 투약"
          }
        }
      }
    },
    "widget.caption.noPrescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a prescription to start"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처방을 입력하면 마디가 시작됩니다"
          }
        }
      }
    },
    "widget.caption.overdue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scheduled date has passed"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예정일이 지났습니다"
          }
        }
      }
    },

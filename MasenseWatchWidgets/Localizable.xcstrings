    "widget.nextDose.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the days until your next dose and the last site."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 투약까지 남은 날과 마지막 부위를 보여 줍니다."
          }
        }
      }
    },

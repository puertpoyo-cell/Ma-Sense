{
  "sourceLanguage": "en",
  "strings": {
    "widget.caption.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logged this cycle · Next dose"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 마디 기록 완료 · 다음 투약"
          }
        }
      }
    },
    "widget.caption.exhausted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a new prescription"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 처방을 입력하세요"
          }
        }
      }
    },
    "widget.caption.next": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next dose"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 투약"
          }
        }
      }
    },
    "widget.caption.noPrescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a prescription to start"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처방을 입력하면 마디가 시작됩니다"
          }
        }
      }
    },
    "widget.caption.overdue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scheduled date has passed"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예정일이 지났습니다"
          }
        }
      }
    },
    "widget.inline %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next dose %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
